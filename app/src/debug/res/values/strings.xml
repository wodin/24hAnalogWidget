<?xml version="1.0" encoding="utf-8"?>
<!--
    Overrides main/ for debug builds only. The debug build installs under its
    own applicationId so it can sit beside upstream's, and two identical labels
    in the launcher and the widget picker would make that unusable - there would
    be no way to tell which dial you were pinning.
-->
<resources>
    <string name="app_name">24h Analog Clock Widget (dev)</string>
    <string name="widget_name">Analog clock, 24h (dev)</string>
</resources>
