<?xml version="1.0" encoding="utf-8"?>
<!--
    fitsSystemWindows because targeting SDK 35 or above makes an activity draw
    edge to edge with no way to opt out: the window now extends under the
    navigation bar, and the last two lines of the intro text were sitting behind
    it. The attribute asks the framework to inset this view by whatever the
    system bars occupy, which is the whole of what is needed here - the action
    bar already handles the top, and nothing in this layout wants to be drawn
    behind a bar.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/RelativeLayout1"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <info.staticfree.android.twentyfourhour.dial.DialView
        android:id="@+id/dial"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@+id/intro_text"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dip"
        android:layout_marginEnd="10dip" />

    <TextView
        android:id="@+id/intro_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tap_health"
        android:layout_alignParentStart="true"
        android:gravity="center"
        android:paddingStart="10sp"
        android:paddingEnd="10sp"
        android:paddingBottom="5sp"
        android:paddingTop="5sp"
        android:text="@string/intro_text"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <!--
        The tap's line: which of its three shapes the widget's tap has on this
        phone. Same shape as the tick's line below, and filled in the same way,
        on every branch.
    -->
    <TextView
        android:id="@+id/tap_health"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tick_health"
        android:layout_alignParentStart="true"
        android:gravity="center"
        android:paddingStart="10sp"
        android:paddingEnd="10sp"
        android:paddingBottom="5sp"
        android:paddingTop="0sp"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <!--
        No android:text. WidgetDemo fills this in during onCreate and fills it
        in on both branches, so the empty view here is never what a person sees,
        and a placeholder would only add a third thing the line could say.

        Smaller than the intro text above it: the intro says what the dial is
        and is read once, this says how the dial is doing and is read whenever
        somebody suspects it of lying.
    -->
    <TextView
        android:id="@+id/tick_health"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:gravity="center"
        android:paddingStart="10sp"
        android:paddingEnd="10sp"
        android:paddingBottom="20sp"
        android:paddingTop="0sp"
        android:textAppearance="?android:attr/textAppearanceSmall" />

</RelativeLayout>